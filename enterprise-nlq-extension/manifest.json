{
  "manifest_version": 3,
  "name": "Enterprise NLQ Assistant",
  "version": "1.0",
  "description": "Trợ lý phân tích dữ liệu doanh nghiệp bằng ngôn ngữ tự nhiên",
  "action": {
    "default_popup": "index.html",
    "default_title": "Mở Trợ lý"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://enterprise-nlq-backend.onrender.com/*"
  ]
}